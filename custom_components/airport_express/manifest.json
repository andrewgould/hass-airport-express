{
  "domain": "airport_express",
  "name": "AirPort Express AirPlay activity",
  "after_dependencies": [
    "apple_tv"
  ],
  "codeowners": [
    "@andrewgould"
  ],
  "config_flow": true,
  "documentation": "https://github.com/andrewgould/hass-airport-express",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/andrewgould/hass-airport-express/issues",
  "requirements": [
    "pyatv>=0.14.0"
  ],
  "version": "1.1.1",
  "zeroconf": [
    {
      "type": "_airplay._tcp.local.",
      "properties": {
        "model": "airport*"
      }
    }
  ]
}
